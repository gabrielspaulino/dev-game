# =============================================================================
# dev-game — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# Never commit real values to source control.
#
# Legend:
#   [REQUIRED]          Must be set in every environment
#   [OPTIONAL]          Falls back to a safe default
#   [SERVER-ONLY]       Must NOT be prefixed with NEXT_PUBLIC_
#   [BROWSER-SAFE]      Safe to expose; use NEXT_PUBLIC_ prefix
#   [DEV-ONLY]          Must never be enabled in production
# =============================================================================

# --- Database --------------------------------------------------------------- #

# [REQUIRED] [SERVER-ONLY]
# Pooled connection string (Supabase pgBouncer or equivalent).
# Used by the application at runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devgame

# [REQUIRED] [SERVER-ONLY]
# Direct (non-pooled) connection string.
# Used by drizzle-kit for migrations only.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devgame

# --- Supabase --------------------------------------------------------------- #

# [REQUIRED] [SERVER-ONLY]
# Supabase project URL (server-side only, without NEXT_PUBLIC_).
SUPABASE_URL=https://your-project.supabase.co

# [REQUIRED] [BROWSER-SAFE]
# Supabase anonymous key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# [REQUIRED] [SERVER-ONLY]
# Supabase service-role key — NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# [OPTIONAL] [SERVER-ONLY]
# JWT issuer and audience for token validation.
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# --- Application ------------------------------------------------------------ #

# [REQUIRED] [BROWSER-SAFE]
# Public base URL of the application.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [OPTIONAL] [SERVER-ONLY]
# Auth redirect URL after login. Defaults to NEXT_PUBLIC_APP_URL/auth/callback.
AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# --- Logging ---------------------------------------------------------------- #

# [OPTIONAL] [SERVER-ONLY]
# Log level: trace | debug | info | warn | error | fatal
# Default: info in production, debug in development.
LOG_LEVEL=debug

# --- Feature Flags ---------------------------------------------------------- #

# [DEV-ONLY] [SERVER-ONLY]
# Enable a local fake identity provider that bypasses Supabase Auth.
# MUST be "false" or unset in production. Validated at startup.
ENABLE_LOCAL_AUTH=false

# [OPTIONAL] [SERVER-ONLY]
# Enable the admin panel routes.
FEATURE_ADMIN_PANEL=true
