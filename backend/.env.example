# Backend environment variables
# Copy this file to .env and fill in real values.
# Never commit .env — it contains real secrets.

# Server
PORT=8080

# Profile: "replit" for Replit dev (no DB), "dev" for local with Docker, "prod" for production.
SPRING_PROFILES_ACTIVE=dev

# Database (JDBC format — use "replit" profile above to skip DB entirely)
# Local: matches docker-compose.yml defaults
# Prefer DEVLEARN_DB_URL; DATABASE_URL and SPRING_DATASOURCE_URL are also accepted.
DEVLEARN_DB_URL=jdbc:postgresql://localhost:5432/devlearn_dev
DATABASE_USERNAME=devlearn
DATABASE_PASSWORD=devlearn_local_dev_only

# Supabase (get from Supabase dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# CORS (comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=DEBUG
